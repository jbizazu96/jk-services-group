    e.preventDefault();
    if (!validateForm()) return;

    try {
      setLoading(true);
      const generatedId = `DJ-${Date.now()}-${Math.random().toString(36).substr(2, 6)}`;

      await addDoc(collection(db, "serviceRequests"), {
        requestId: generatedId,
        customerName: bookingForm.fullName,
        email: bookingForm.email,
        phone: bookingForm.phone,
        serviceType: "DJ Music Services",
        category: "DJ Services",
        status: "pending",
        source: "pricing",
        requestType: "booking",
        package: bookingForm.package,
        hoursIncluded: djPackages[selectedPackage]?.hoursIncluded,
        eventType: bookingForm.eventType,
        eventDate: bookingForm.eventDate,
        eventTime: bookingForm.eventTime,
        eventLocation: bookingForm.eventLocation,
        venueSize: bookingForm.venueSize,
        guestCount: bookingForm.guestCount,
        musicGenres: selectedGenres,
        addOns: selectedAddOns,
        budget: totalPrice,
        basePrice: djPackages[selectedPackage]?.basePrice || 0,
        message: bookingForm.message,
        description: `DJ BOOKING: ${bookingForm.package}\nHours: ${djPackages[selectedPackage]?.hoursIncluded}\nEvent: ${bookingForm.eventType}\nDate: ${bookingForm.eventDate}\nTime: ${bookingForm.eventTime}\nLocation: ${bookingForm.eventLocation}\nVenue: ${bookingForm.venueSize}\nGuests: ${bookingForm.guestCount}\nGenres: ${selectedGenres.join(", ") || "Not specified"}\nAdd-Ons: ${selectedAddOns.map(a => a.name).join(", ") || "None"}\nTotal Price: $${totalPrice}\n\nMessage: ${bookingForm.message}`,
